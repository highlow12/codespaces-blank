{
  "name": "atomic-clusters",
  "version": "0.1.0",
  "description": "Offline hierarchical note clustering for Obsidian desktop",
  "private": true,
  "license": "MIT",
  "main": "main.js",
  "dependencies": {
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "sql.js": "^1.13.0",
    "umap-js": "1.4.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:release": "npm run build:wasm && node build.mjs --require-wasm",
    "test": "node --test tests/*.test.mjs",
    "audit:hdbscan": "node scripts/hdbscan-parity-audit.mjs",
    "validate:offline": "node scripts/offline-e2e.mjs",
    "benchmark:large-vault": "node scripts/large-vault-hardening.mjs",
    "dev": "node build.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
